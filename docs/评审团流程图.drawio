          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="3/4/5/8 → _await_pending&#10;9 phase=await_answer&#10;→ 停住等学生" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_mgr" target="n_end">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="n_note2" value="两种 END 含义不同：&#10;· await_answer：图停住等学生回答，这次请求正常结束 → 前端弹答题框&#10;· done：会议真的开完了 → 展示会议纪要和未答好清单" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="420" y="400" width="520" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
