        <mxCell id="p3b8" value="followup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3b9" value="done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3e10" value="抽完要素表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b2" target="p3b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e11" value="主问题问完" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b3" target="p3b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e12" value="接话环节结束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b4" target="p3b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e13" value="学生交回答&#xa;（带同一 session_id 重新 astream）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b5" target="p3b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b6" target="p3b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e15" value="本议题还有没判过的问题" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b7" target="p3b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e16" value="都答完了、有人没被说服&#xa;且本议题还没追过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b7" target="p3b8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e17" value="追问完" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b8" target="p3b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e18" value="议题收尾，换下一位评审" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p3b7" target="p3b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3e19" value="轮次用完，散会" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;dashed=1;" edge="1" parent="1" source="p3b3" target="p3b9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3b20" value="有人接话（每个议题最多 1 次）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.2;entryX=1;entryY=0.8;" edge="1" parent="1" source="p3b4" target="p3b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3b21" value="两个容易讲错的点&#xa;&#xa;① await_answer 不是「挂起」：LangGraph 没有挂起语义。manager 在 await_answer 处 goto=END，这次 HTTP 请求就结束了，&#xa;   状态被写进 PostgreSQL 检查点；学生答完再发一次请求，带同一个 thread_id，图从 START 进 manager，&#xa;   看到 phase=judge 就知道该去判定 —— 和模拟面试续多轮是同一套路，所以进程重启也接得上。&#xa;&#xa;② 图会停在两种 END 上，含义完全不同：await_answer = 等学生回答（前端弹答题框）；done = 真的开完了（展示纪要 + 未答好清单）。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1080" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3b22" value="一个议题的完整生命周期&#xa;&#xa;main（某位评审提主问题）&#xa;  → cross（别的评审可以当场接话反驳，每个议题最多 1 次）&#xa;  → await_answer（停下等学生回答；本议题可能有好几条问题，按提问顺序一条条答）&#xa;  → judge（由**这条问题的提问者**判定：答清楚了 / 答得不全 / 没答）&#xa;  → advance（看整个议题决定下一步）&#xa;       · 还有没判过的问题 → 继续 await_answer&#xa;       · 都答完、有人没被说服且本议题还没追过 → followup（追问 1 层）&#xa;       · 否则 → 换下一位评审（清掉 _ISSUE_RESET 的 10 个议题字段）&#xa;  → 四位都问完 → done（散会）&#xa;&#xa;为什么同时只能答一条：屏幕上永远只有一个「待你回答」，&#xa;不会出现三个人一起问、学生不知道该答谁（这个坑是照着真实界面截图改的）。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1080" height="340" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. 一次完整问答走位" id="page-4">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
