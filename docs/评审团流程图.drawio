          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b7" value="4  前端：弹答题框「请回答 技术评审 的质询（本议题第 1/2 问）」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="216" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b5" target="p4b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b9" value="5  POST /meeting/answer：校验检查点里确实是 await_answer，写 student_answer 重新 astream   ← 请求 ②" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="268" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b7" target="p4b9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b11" value="6  judge：技术评审判 unresolved、severity 4、followup_hint「按多少用户算的」&#xa;     判定回填索引 + 回答与评语写回 MySQL 那条 → phase = advance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b9" target="p4b11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b13" value="7  manager：本议题还有没判过的（成本评审的接话）→ 停住等第 2 问   ← 请求 ② 结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="372" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b11" target="p4b13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b15" value="8  前端：答题框「请回答 成本与进度评审 的质询（本议题第 2/2 问）」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b13" target="p4b15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b17" value="9  POST /meeting/answer → judge：成本评审判完自己那条   ← 请求 ③" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="476" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b15" target="p4b17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b19" value="10 manager：都答完了、技术评审那条 unresolved 且有 hint → phase = followup，current_speaker = tech" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="528" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b17" target="p4b19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b21" value="11 speaker（followup）：技术评审追问（按索引取回本议题问答 + followup_hint）   ← 请求 ③ 结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b19" target="p4b21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b23" value="12 POST /meeting/answer → judge：判追问那条   ← 请求 ④" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b21" target="p4b23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b25" value="13 manager：本议题已追过 → _next_speaker（换成本评审，清 10 个议题字段）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="684" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p4e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p4b23" target="p4b25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4b27" value="讲这段时强调什么&#xa;&#xa;· 同一个议题 4 次 HTTP 请求，&#xa;  中间隔着学生在页面上的输入&#xa;&#xa;· 每次请求都从 START 进 manager，&#xa;  靠检查点里的 meeting_phase&#xa;  决定该干哪一步&#xa;&#xa;· 一个议题里可能好几位评审都&#xa;  问了话，学生按提问顺序&#xa;  一条条答，每条由那条问题的&#xa;  提问者判 —— 谁的疑问谁负责&#xa;&#xa;· 界面上永远只有一个待答问题&#xa;&#xa;· 接话那条也要求学生回答，&#xa;  否则「接话问了没人判」，&#xa;  进不了未答好清单（踩过）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="830" y="60" width="310" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. 判定后怎么走" id="page-5">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5b1" value="⑤ 判定之后怎么走（_route_after_judge）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5b2" value="一次判定结束（phase = advance）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p5b3" value="本议题还有&#xa;没判过的问题吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5b4" value="_await_pending：接着问下一条&#xa;主问题、接话按提问顺序来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5b5" value="followup_depth &lt; 1&#xa;且本议题还没追过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5b6" value="_next_speaker：换下一位评审&#xa;本轮没了就下一轮，轮次用完散会" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="275" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5b7" value="找得到这样一条吗：&#xa;判定非 resolved&#xa;且 followup_hint 非空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5b8" value="goto speaker：由它的提问者追一层&#xa;phase = followup，followup_depth = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b2" target="p5b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e10" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b3" target="p5b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e11" value="没有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b3" target="p5b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b5" target="p5b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b5" target="p5b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e14" value="找不到" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b7" target="p5b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5e15" value="找到" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p5b7" target="p5b8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p5b16" value="_await_pending（决定学生现在答哪一条）&#xa;    本议题（最后一条主问题往后那段）里，第一条还没判过的问题：&#xa;        pending_question = 它的题干；pending_type = 它的类型；pending_from = 它的提问者；pending_id = 库里那条记录的 id&#xa;        meeting_phase = await_answer，goto=END&#xa;    兜底：一条都没找到（理论上不可能）→ 直接换下一位，不让会议卡住。&#xa;&#xa;_next_speaker（换人 / 换轮 / 散会）&#xa;    speaker_index + 1 &lt; len(speaker_order) → 换下一位，phase = main&#xa;    本轮说完且 round &lt; max_round        → round += 1，回到第一位&#xa;    都不满足                            → END，phase = done&#xa;    换人 / 换轮时把 _ISSUE_RESET 的 10 个字段一起清（漏一个就会出现「新问题沿用上一题的标记」）。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1080" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. 状态与落库" id="page-6">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6b1" value="⑥ 状态只留索引，正文放 MySQL（检查点体积降一个数量级）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6b2" value="ReviewState（图的状态 = 检查点里那一份）&#xa;&#xa;方案：plan_text（抽完要素即清空）、plan_elements&#xa;会话：session_id&#xa;会议控制：meeting_phase、round、max_round、&#xa;        speaker_order、speaker_index、current_speaker&#xa;当前议题：pending_question、pending_type、&#xa;        pending_from、pending_id、followup_depth、&#xa;        followup_hint、student_answer&#xa;防跑偏：cross_in_issue、cross_total、spoke_in_issue、&#xa;      cross_checked、max_cross_per_issue、max_cross_total&#xa;产出：question_index（全场问答的索引）&#xa;&#xa;已删除的字段：messages / question_log /&#xa;unresolved / minutes / diagnosis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="330" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p6b3" value="question_index 的每一条（索引）&#xa;&#xa;id                review_question 主键（对回正文的键）&#xa;round             第几轮&#xa;speaker_role      谁问的（tech/cost/compliance/user）&#xa;question_type     main / cross / followup&#xa;target_speaker    接话时被接的人&#xa;verdict           判定结果（resolved/partial/unresolved）&#xa;severity          1~5&#xa;followup_depth    追问层数&#xa;followup_hint     追问方向（manager 要读）&#xa;question          **只在这条还没答时留着**，判完即删&#xa;&#xa;为什么 question 只留一会儿：&#xa;manager 是同步节点、零 I/O，&#xa;_await_pending 要把题干填进 pending_question，&#xa;这一下不能查库。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="60" width="330" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p6b4" value="MySQL · review_question（13 字段）&#xa;&#xa;id, session_id, round, speaker_role, question_type,&#xa;target_speaker, question, student_answer, verdict,&#xa;verdict_comment, severity, followup_depth, created_at&#xa;&#xa;写入时机（边开会边写透）&#xa;· store.ask()          发言一抛出来就插一条，拿回 id&#xa;· store.save_verdict() 学生答完把回答/判定/评语写回那条&#xa;· 散会不再整批重写（重写会把 id 全换掉）&#xa;&#xa;取正文的入口（store/question_store.py，唯一出口）&#xa;· rows_of(entries)      按索引取一批（判定拼本议题、接话拼最近 6 条）&#xa;· question_of(entry)    取单条题干（接话要针对的那句）&#xa;· all_rows(session_id)  整场取回：散会纪要 + 接话查重&#xa;&#xa;实测收益（同一场真实会议，scripts/measure_review_tokens.py）&#xa;· 检查点累计写入 428 KB → 49.5 KB（8.7 倍）&#xa;· 状态不再随问答条数平方增长&#xa;· 提示词一字未改（动的是状态，不是提示词）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="750" y="60" width="390" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p6e5" value="索引里的 id = 库里那条记录的主键&#xa;（取正文全靠它）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p6b3" target="p6b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6e6" value="manager 只看索引&#xa;（每秒都跑，零 I/O）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p6b2" target="p6b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
