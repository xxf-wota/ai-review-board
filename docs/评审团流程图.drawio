          <mxGeometry x="40" y="492" width="700" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p8e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p8b11" target="p8b13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p8b15" value="讲这几个接口时要说的&#xa;&#xa;· 用 POST + SSE 而不是 EventSource：&#xa;  方案正文可能上万字，塞不进 URL，&#xa;  前端用 fetch + ReadableStream 读&#xa;&#xa;· 两个入口串起一场会：&#xa;  /meeting/start 开场，&#xa;  /meeting/answer 交回答&#xa;&#xa;· /meeting/answer 会先校验：&#xa;  检查点里 phase 必须是 await_answer&#xa;  （否则 404 / 409），&#xa;  不然乱填 session_id 会让图凭空&#xa;  从 START 开一场空会议&#xa;&#xa;· 散会时 router 只把会话状态改成&#xa;  finished —— 质询记录在开会过程中&#xa;  已经逐条写透了，不再整批重写&#xa;&#xa;· 落库失败只打日志、不往上抛：&#xa;  前端已经边收边渲染了，&#xa;  不能把已经开完的会毁掉" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="360" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="9. 关键数字与问答要点" id="page-9">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9b1" value="⑨ 关键数字与面试问答要点" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p9b2" value="状态与成本&#xa;· 检查点累计写入 428 KB → 49.5 KB（8.7 倍）&#xa;· 一场会约 18 次模型调用 / 25k 字提示词&#xa;· 一场会 7~9 问、4 次接话、1 次追问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b3" value="接话去重（8 场 26 条真实接话标定）&#xa;· 字面 Jaccard 0.7：只挡 1 条&#xa;· 向量余弦 0.80（整场比对）：挡 13 条&#xa;· 余弦 0.70：挡 19 条但误杀 3 条&#xa;· 重排序（备选，未启用）：1 条不漏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b4" value="防跑偏与质量&#xa;· 每议题最多接话 1 次（MAX_CROSS_PER_ISSUE）&#xa;· 全场最多接话 6 次（MAX_CROSS_TOTAL）&#xa;· 同议题已发言者不再接话&#xa;· 每议题最多追问 1 层（MAX_FOLLOWUP）&#xa;· 跳过 → 不追问（短路不调模型）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="60" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b5" value="M1~M5（全部已验收）&#xa;M1 方案提交 + 要素抽取（8 字段 + 缺失项）&#xa;M2 四位评审（相似度最高 0.07、越界 0/4）&#xa;M3 交叉质询（5 请求 116 事件、配对 8/8）&#xa;M4 作答 + 追问（跳过 0 追问、封顶 1 层）&#xa;M5 纪要 + 未答好清单（7 条记录 / 4 条未答好）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b6" value="验收脚本（都能变红）&#xa;· check_startup.py  16 项（真起服务，跑 8801）&#xa;· check_page.py     17 项（页面不变式）&#xa;· check_review_index.py 29 项（离线索引化）&#xa;· check_dedup.py    17 项（去重，--reverse 反向验）&#xa;· dry_run_demo.py   真模型预跑（--expect-cross）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b7" value="模型选型&#xa;· 本地固定 qwen2.5:7b&#xa;  （qwen3.5:9b 抽要素 313.8 秒，&#xa;   且不认 response_format，会静默失败）&#xa;· 正式演示走商业 qwen3.7-flash&#xa;· 向量模型走本地 ONNX（不占显存、不装 torch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="240" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p9b8" value="被问到这些时的答法&#xa;&#xa;问：为什么评审会不用四层记忆？&#xa;答：一场评审会一次性结束，不需要跨会话记住谁；它需要的是「别忘了刚才说到哪」，那是检查点的事。&#xa;    把学生的长期画像喂进来反而会干扰判定（评审该按方案本身判）。所以是「一套记忆基础设施、两种用法」。&#xa;&#xa;问：四个 AI 会不会说一样的话、或者变成无限互怼？&#xa;答：两件事都有硬约束。视角不重复靠写死且互斥的关注点清单（实测两两相似度最高 0.07）；&#xa;    互怼有三道额度锁 + 追问封顶 1 层 + 接话语义去重（余弦 0.80，判定标准是拿 8 场真数据量出来的）。&#xa;&#xa;问：为什么判定不给总分？&#xa;答：一句话里塞三个问题是判不出「答没答到点上」的，所以我们只保留第一个问句、逐问题判定（答了 / 答偏了 / 没答），&#xa;    分数只作参考维度。最终产出是「未答好的问题清单」，学生能当改稿工单用。&#xa;&#xa;问：这套东西的局限？&#xa;答：① 接话内容质量随模型能力波动（机制、额度、箭头全部可复现，内容是概率性的）；&#xa;    ② 评审会的 session_id 没有归属校验（面试那半有）；③ 画像与评估两处只走商业模型，没有本地兜底。&#xa;    这三条都写进 README 的已知事项了 —— 宁可自己先说。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="420" width="1110" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
