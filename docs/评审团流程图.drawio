<mxfile host="app.diagrams.net" pages="9">
  <diagram name="1. 系统总览" id="page-1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1b1" value="① 系统总览：一次评审会的全链路" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1b2" value="浏览器（Vue2 单页，无构建）app/html/app.html&#xa;· 左侧按钮切换两个智能体：模拟面试 / 交叉质询评审团&#xa;· 评审会界面：评审气泡、⟶ 接话箭头、答题框、纪要 + 未答好清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1b3" value="login.html：邮箱 + 验证码（真发信 SMTP）&#xa;登录即建业务会话（user_id = email）&#xa;登录态存 sessionStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1b4" value="FastAPI · app/web/review_router&#xa;POST /review/upload（Word / PDF / txt → 纯文本）&#xa;POST /review/submit（抽要素表 + 落库）   GET /review/session/{id}（读回纪要 + 未答好清单）&#xa;POST /review/meeting/start（SSE 开场）   POST /review/meeting/answer（SSE 交回答，skip=true 可跳过）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="780" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1b5" value="LangGraph ReviewGraph（与模拟面试图共用同一个 PostgreSQL 检查点，靠 thread_id 区分）&#xa;manager（同步调度中枢，Command(goto=…) 动态跳转）· extract · speaker · cross · judge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1b6" value="本地模型（优先）&#xa;Ollama qwen2.5:7b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="460" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1b7" value="商业模型（失败降级）&#xa;DashScope qwen3.7-flash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1b8" value="本地 ONNX 向量模型&#xa;接话去重（余弦 0.80）&#xa;384 维 / 7 ms 一句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="570" y="460" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1b9" value="PostgreSQL&#xa;图检查点&#xa;(AsyncPostgresSaver)&#xa;+ 摘要记忆" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1b10" value="MySQL&#xa;review_session（8 字段）&#xa;review_question（13 字段）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="600" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1b11" value="Redis&#xa;会话 / 窗口记忆 / 画像&#xa;/ 会话锁" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1b12" value="Chroma&#xa;长期记忆&#xa;（模拟面试用；评审会不用）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1b13" value="为什么要这么分&#xa;&#xa;· 评审会只活在一场会议里&#xa;  → 不需要四层记忆，只需要&#xa;    检查点（把会议接到下一次请求）&#xa;&#xa;· 状态里不放问答正文&#xa;  → 只留索引（id + 判定结果），&#xa;    正文写 MySQL，按 id 现取&#xa;&#xa;· 模型本地优先、商业降级&#xa;  → 演示走商业模型更稳；&#xa;    本地 qwen2.5:7b 也能整场跑通" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="60" width="300" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p1e14" value="登录后进单页" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b3" target="p1b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e15" value="HTTP / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p1b2" target="p1b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e16" value="驱动图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p1b4" target="p1b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e17" value="调用（本地优先）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e18" value="降级" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e19" value="接话去重打分" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e20" value="每个超步写检查点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e21" value="提交方案 / 读回纪要" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b4" target="p1b10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e22" value="边开会边写透质询记录" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e23" value="会话 / 锁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1e24" value="（评审模块不用）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#cccccc;fontSize=11;dashed=1;" edge="1" parent="1" source="p1b5" target="p1b12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. 节点拓扑与决策表" id="page-2">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2b1" value="② 节点拓扑与 manager 决策表（改调度只改这里）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2b2" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="90" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2b3" value="manager&#xa;调度中枢（同步、零 I/O）" style="hexagon;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="160" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2b4" value="END（图停住）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="190" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2b5" value="extract　方案要素抽取&#xa;（只能模型抽不出来时给兜底要素表）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2b6" value="speaker　评审发言&#xa;主问题 与 追问共用这一个节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2b7" value="cross　接话判定 + 接话发言&#xa;（含炒冷饭去重）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2b8" value="judge　回答判定&#xa;由该问题的提问者判" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p2e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p2b2" target="p2b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e10" value="1 没有要素表" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p2b3" target="p2b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e11" value="2 phase = main / followup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p2b3" target="p2b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e12" value="6 phase = cross 且还有额度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p2b3" target="p2b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e13" value="7 phase = judge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p2b3" target="p2b8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e14" value="3/4/5 → 停住等回答&#xa;8/9/10/11 → 散会 / 防跑飞" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;dashed=1;" edge="1" parent="1" source="p2b3" target="p2b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" parent="1" source="p2b5" target="p2b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" parent="1" source="p2b6" target="p2b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" parent="1" source="p2b7" target="p2b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" parent="1" source="p2b8" target="p2b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2b19" value="manager 决策表（自上而下第一条命中生效）&#xa;&#xa;1  plan_elements 为空 → extract&#xa;2  phase ∈ {main, followup} → speaker&#xa;3  phase=cross 且 cross_checked → 停住等回答&#xa;4  phase=cross 且 cross_in_issue ≥ 1 → 停住&#xa;5  phase=cross 且 cross_total ≥ 6 → 停住&#xa;6  phase=cross（上面都不满足）→ cross&#xa;7  phase = judge → judge&#xa;8  phase = advance → _route_after_judge&#xa;9  phase = await_answer → END（防跑飞）&#xa;10 phase = done → END&#xa;11 其它阶段 → END + done（不让会议卡死）&#xa;&#xa;为什么画不出自动图：&#xa;manager 用 Command(goto=…) 动态跳转，&#xa;不是静态 conditional edge ——&#xa;LangGraph 自带的 draw_mermaid()&#xa;只会画出「节点全回中枢」，&#xa;分支一条都看不到，所以这张图是手画的。" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="380" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. meeting_phase 状态机" id="page-3">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3b1" value="③ meeting_phase 状态机（会议怎么往前走）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
