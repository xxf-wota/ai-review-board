          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="每个节点干完都回中枢" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ext" target="n_mgr">
