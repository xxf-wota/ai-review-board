          <mxGeometry x="60" y="60" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_spk" value="speaker&#10;评审发言（主问题 / 追问）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
