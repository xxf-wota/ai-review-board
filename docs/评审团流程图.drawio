        <mxCell id="p7b1" value="⑦ 接话去重（炒冷饭防线）：向量余弦 0.80 + 整场比对" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="30" as="geometry" />
        </mxCell>
