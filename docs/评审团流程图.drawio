        <mxCell id="p7e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b4" target="p7b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7e13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b5" target="p7b9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7e14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b5" target="p7b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b6" target="p7b7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7e16" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b7" target="p7b8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7e17" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="p7b7" target="p7b9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7b18" value="为什么不用字面相似度&#xa;&#xa;拿 8 场真模型评审会、26 条真实接话量过：&#xa;· 字面 Jaccard ≥ 0.7 只挡住 1 条&#xa;  （26 条里字面分最高才 0.593 ——&#xa;   换个说法它完全认不出来）&#xa;· 只比「对方原话 + 自己问过的」&#xa;  会漏掉跨议题的逐字复述&#xa;  （那既不是接话对象、也不是自己问的）&#xa;· 换成余弦 + 整场比对：&#xa;    0.80 挡 13 条；0.70 挡 19 条，&#xa;    但会把 #202(0.856)/#221(0.767)/&#xa;    #199(0.779) 这类「不同评审从各自&#xa;    角度追问同一主题」误杀 ——&#xa;    那正是交叉质询要的效果&#xa;&#xa;· 兜底：向量模型不可用 → 退回字面&#xa;  DEDUP_BIGRAM = 0.7（只认逐字重复）&#xa;· 真模型实测：一场会里拦截两次，&#xa;  放弃了一条接话，会议照常往下走&#xa;&#xa;标定脚本 scripts/calibrate_dedup.py&#xa;自检脚本 scripts/check_dedup.py（17 项）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="340" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
