        <mxCell id="p4b1" value="④ 一次完整问答的走位（同一个议题要 4 次 HTTP 请求）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
