        <mxCell id="p4b2" value="1  speaker（main）：技术评审提主问题&#xa;     question_index += 一条（落库拿到 id）；cross_checked = False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
