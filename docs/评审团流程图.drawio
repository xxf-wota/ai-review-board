          <mxGeometry x="40" y="320" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p7b6" value="重试一次&#xa;提示词里把被重复的那句原话念给模型听" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
