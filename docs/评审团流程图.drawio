        <mxCell id="n_end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="285" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_note" value="manager 用 Command(goto=...) 动态跳转，&#10;不是静态 conditional edge ——&#10;所以 LangGraph 自带的&#10;draw_mermaid() 画不出这些分支。" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
