        </mxCell>
        <mxCell id="n_crs" value="cross&#10;接话判定 + 接话发言" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="60" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_jdg" value="judge&#10;回答判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
