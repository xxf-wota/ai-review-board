# ==========================================================
# 环境配置模板
# 用法：复制成 .env，把下面的值换成自己机器上的真实值
#       .env 已被 .gitignore 忽略，不会被提交
# ==========================================================

# ---------- 商业模型（阿里云 DashScope）----------
MODEL_LINE_NAME=qwen3.7-flash-2026-07-15
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云百炼控制台申请，sk- 开头
DASHSCOPE_API_KEY=在这里填你的 DashScope API Key

# ---------- 本地模型（Ollama）----------
# 必须是支持原生结构化输出的模型，推荐 qwen2.5:7b
# 实测 qwen3.5:9b 不可用：默认带思考、不认 response_format，详见 docs 里的实测记录
MODEL_LOCAL_NAME=qwen2.5:7b
LOCAL_URL=http://localhost:11434/v1

# ---------- 邮件 ----------
EMAIL_HOST=smtp.qq.com
EMAIL_FROM=你的邮箱@qq.com
EMAIL_PORT=465
# QQ 邮箱的授权码，不是登录密码
EMAIL_PASSWORD=在这里填邮箱授权码

# ---------- PostgreSQL ----------
# 图状态检查点 + 摘要记忆都用它
POSTGRESQL_URL=postgresql://postgres:你的密码@localhost:5432/postgres?sslmode=disable

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填MySQL密码
MYSQL_DATABASE=agent_project
MYSQL_CHARSET=utf8mb4

# ---------- 窗口记忆 ----------
# 生产环境一般 20 轮即 40 条，调试时可以调小
WINDOW_MEMORY_ROUNDS=40
# 单位秒，生产环境一般 1 天
WINDOW_MEMORY_TIME=86400

# ---------- 本地资源路径（按自己机器改）----------
# 长期记忆（Chroma 向量库）的存储目录，留空会写到项目下的 data/chroma_db
CHROMA_PATH=D:/Projects/exam_agent/data/chroma_db
VOSK_PATH=F:/models/vosk-model-cn-0.22

# ---------- 接话去重用的本地向量模型（可选）----------
# 评审互相接话时，用向量余弦判断"这句话是不是把整场问过的某个问题又说了一遍"。
# 只要 onnxruntime + tokenizers 就能跑（不装 torch）。目录里要有 tokenizer.json
# 和 ONNX 导出；用的是 paraphrase-multilingual-MiniLM-L12-v2 的 onnx 版。
# bge-base-zh-v1.5 只有 pytorch 权重，要用得先转 ONNX。
# 目录不存在或加载失败时不会报错，自动退回字面相似度（弱得多，只认逐字重复）。
EMBED_MODEL_DIR=F:/models/paraphrase-multilingual-MiniLM-L12-v2
EMBED_ONNX_FILE=onnx/model.onnx
# 池化方式：mean（该模型是 mean_tokens）或 cls
EMBED_POOLING=mean
EMBED_MAX_LEN=256

# ---------- 备选：重排序模型（判定路径没启用，只用于标定对照）----------
# bge-reranker-large_v1 的 ONNX 导出（model.onnx + 同目录 model.onnx_data）
RERANK_MODEL_DIR=F:/models/bge-reranker-large_v1
RERANK_ONNX_FILE=onnx/model.onnx
RERANK_MAX_LEN=256
