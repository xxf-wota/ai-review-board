# ==========================================================
# 环境配置模板
# 用法：复制成 .env，把下面的值换成自己机器上的真实值
#       .env 已被 .gitignore 忽略，不会被提交
# ==========================================================

# ---------- 商业模型（阿里云 DashScope）----------
MODEL_LINE_NAME=qwen3.7-flash-2026-07-15
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云百炼控制台申请，sk- 开头
DASHSCOPE_API_KEY=在这里填你的 DashScope API Key

# ---------- 本地模型（Ollama）----------
# 必须是支持原生结构化输出的模型，推荐 qwen2.5:7b
# 实测 qwen3.5:9b 不可用：默认带思考、不认 response_format，详见 docs 里的实测记录
MODEL_LOCAL_NAME=qwen2.5:7b
LOCAL_URL=http://localhost:11434/v1

# ---------- 邮件 ----------
EMAIL_HOST=smtp.qq.com
EMAIL_FROM=你的邮箱@qq.com
EMAIL_PORT=465
# QQ 邮箱的授权码，不是登录密码
EMAIL_PASSWORD=在这里填邮箱授权码

# ---------- PostgreSQL ----------
POSTGRES_URL=postgresql://postgres:你的密码@localhost:5432/postgres?sslmode=disable

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=在这里填MySQL密码
MYSQL_DATABASE=agent_project
MYSQL_CHARSET=utf8mb4

# ---------- 窗口记忆 ----------
# 生产环境一般 20 轮即 40 条
WINDOW_SIZE=4
# 单位秒，生产环境一般 1 天
WINDOW_EXPIRE_TIME=86400

# ---------- 本地资源路径（按自己机器改）----------
CHROMA_PATH=D:/Projects/stu_agent/chroma_db
VOSK_PATH=F:/models/vosk-model-cn-0.22
